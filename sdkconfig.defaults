# Settings shared by every chip. Chip-specific ones (flash, PSRAM, partitions,
# memory sizing) are in sdkconfig.defaults.<target>, which ESP-IDF layers on top.

# A new image must confirm itself (Wi-Fi up) or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Console + setup menu on the native USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# WebSocket hub at /ws (core/web_ws.c). Existing build dirs: delete sdkconfig
# so this applies, or the build stops with an #error.
CONFIG_HTTPD_WS_SUPPORT=y

# The web log hook (core/logbuf.c) formats each line on the logging task's stack;
# give the default event loop, which logs Wi-Fi/IP events, some headroom.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# BLE central (NimBLE) for the BMS link (features/bms.c). One connection. The
# peripheral role stays enabled because it brings the ATT server: the BMS sends
# its own MTU request, which must be answered (the board never advertises). The
# BMS requires passkey pairing (default 123456) before it accepts notifications;
# the bond is kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
